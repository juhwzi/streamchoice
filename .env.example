# URL pública do app (sem barra final). Usada no redirect_uri do OAuth da Kick.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sessão do app (gere com: openssl rand -base64 32)
SESSION_SECRET=

# Kick OAuth 2.1 (https://dev.kick.com) — redirect: {APP_URL}/api/auth/kick/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# TMDB (use o "API Read Access Token", v4)
TMDB_READ_TOKEN=

# IGDB (credenciais de app da Twitch)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Opcional: nome do header de assinatura do gateway (padrão: tenta os mais comuns)
WEBHOOK_SIGNATURE_HEADER=

# Administrador(es) do StreamChoice — IDs são preferíveis a usernames.
# Exemplo: ADMIN_KICK_USER_IDS=123456789,987654321
ADMIN_KICK_USER_IDS=
# Opcional para bootstrap/dev: ADMIN_KICK_USERNAMES=seuusuario
ADMIN_KICK_USERNAMES=
